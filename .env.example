# ------------------------------------------------------------------
# Local frontend. `npx convex dev` writes this automatically.
# ------------------------------------------------------------------
VITE_CONVEX_URL=

# ------------------------------------------------------------------
# LLM extraction. Any OpenAI compatible chat completions endpoint.
#
# Default in this build: Groq. No OpenAI account is required.
# Create a free key at https://console.groq.com/keys
# ------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# To use OpenAI instead, uncomment and remove the Groq block:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------
# Official source verification via Firecrawl
# Create a key at https://firecrawl.dev
# ------------------------------------------------------------------
FIRECRAWL_API_KEY=

# ------------------------------------------------------------------
# AgentMail inbox intake and approved outbound follow up
# Create a key at https://agentmail.to
# ------------------------------------------------------------------
AGENTMAIL_API_KEY=
AGENTMAIL_BASE_URL=https://api.agentmail.to
AGENTMAIL_WEBHOOK_SECRET=
